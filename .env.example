export AWS_ACCOUNT_ID="123456789012"
export SES_EMAIL="seu-email@gmail.com"
export APP_API_KEY="sua-api-key"
export APP_JWT_SECRET="seu-jwt-secret"
export DB_NAME="nome_do_banco"
export DB_USERNAME="usuario_do_banco"
